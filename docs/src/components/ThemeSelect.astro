---
/**
 * Replaces Starlight's Dark/Light/Auto dropdown with a single icon toggle,
 * OpenAI-style. Clicking flips the *resolved* theme and pins it through
 * Starlight's own provider (`window.StarlightThemeProvider`), so storage
 * and any other pickers stay in sync. The icon swap is pure CSS, driven by
 * `:root[data-theme]`, which always holds the resolved theme.
 */
---

<theme-toggle>
	<button type="button" aria-label="Toggle color theme">
		<svg
			class="sun"
			aria-hidden="true"
			width="18"
			height="18"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.8"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<circle cx="12" cy="12" r="4"></circle>
			<path
				d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41"
			></path>
		</svg>
		<svg
			class="moon"
			aria-hidden="true"
			width="18"
			height="18"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.8"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
		</svg>
	</button>
</theme-toggle>

<script>
	customElements.define(
		'theme-toggle',
		class ThemeToggle extends HTMLElement {
			constructor() {
				super();
				const button = this.querySelector('button');
				button?.addEventListener('click', () => {
					const next =
						document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
					const provider = (window as any).StarlightThemeProvider;
					if (provider?.updatePickedTheme) {
						provider.updatePickedTheme(next);
					} else {
						document.documentElement.dataset.theme = next;
						try {
							localStorage.setItem('starlight-theme', next);
						} catch {}
					}
				});
			}
		}
	);
</script>
